# Optional: MongoDB Connection URI.
# If omitted or empty, the backend automatically uses TinyDB (embedded NoSQL document store at backend/data/climate_nosql_db.json).
MONGODB_URI=
MONGODB_DB_NAME=climate_hazard_analyzer

# Optional: Custom TinyDB JSON document path
TINYDB_PATH=backend/data/climate_nosql_db.json

# Optional (Frontend): Override API Base URL when deploying frontend separately (e.g. Vercel -> Render)
VITE_API_BASE_URL=

